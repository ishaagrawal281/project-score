# === Server Configuration ===
PORT=5000
NODE_ENV=development

# === Frontend URL (CORS) ===
FRONTEND_URL=http://localhost:3000

# === Database Configuration (PostgreSQL with Prisma) ===
DATABASE_URL="postgresql://postgres:password@localhost:5432/document_vault?schema=public"

# === JWT Authentication ===
JWT_SECRET=your_secure_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# === Google Cloud Storage (Optional) ===
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_CLOUD_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# === File Upload ===
# MAX_FILE_SIZE=52428800  # 50MB in bytes
# UPLOAD_DIR=./uploads

# === Email Configuration (Optional - for future features) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@docvault.com

# === Rate Limiting (Optional) ===
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100
